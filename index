<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>导引 · 课文音频 & 听力制作</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background: linear-gradient(145deg, #f0f4fa 0%, #d9e2ef 100%);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-family: system-ui, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
      padding: 1.5rem;
    }

    .card {
      background: rgba(255, 255, 255, 0.6);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-radius: 3.5rem;
      padding: 3rem 2.5rem;
      box-shadow: 0 30px 50px rgba(0, 20, 40, 0.2),
                  inset 0 1px 4px rgba(255, 255, 255, 0.8);
      border: 1px solid rgba(255, 255, 255, 0.7);
      max-width: 760px;
      width: 100%;
      transition: all 0.2s;
    }

    h1 {
      text-align: center;
      font-weight: 500;
      font-size: 2.2rem;
      letter-spacing: -0.01em;
      color: #1f2e4a;
      margin-bottom: 2.2rem;
      text-shadow: 0 2px 6px rgba(255, 255, 255, 0.8);
      word-break: break-word;
    }

    .button-group {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 2rem;
      margin-bottom: 3rem;
    }

    .nav-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 220px;
      padding: 1.2rem 2.2rem;
      border-radius: 60px;
      font-size: 1.3rem;
      font-weight: 600;
      text-decoration: none;
      color: white;
      letter-spacing: 0.3px;
      background: linear-gradient(135deg, #2b5a9e, #1b3b6b);
      box-shadow: 0 15px 20px -8px rgba(0, 30, 70, 0.5),
                  0 0 0 1px rgba(255, 255, 255, 0.2) inset;
      transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s;
      cursor: pointer;
      border: none;
      text-align: center;
      line-height: 1.3;
      word-break: break-word;
    }

    .nav-btn:hover {
      transform: translateY(-4px);
      box-shadow: 0 24px 28px -12px rgba(0, 25, 70, 0.6),
                  0 0 0 1px rgba(255, 255, 255, 0.4) inset;
      filter: brightness(1.08);
    }

    .nav-btn:active {
      transform: translateY(2px);
      box-shadow: 0 10px 15px -6px rgba(0, 20, 60, 0.5);
      filter: brightness(0.98);
    }

    /* 第二个按钮使用不同的渐变色调以示区分 (听力制作) */
    .nav-btn.listen {
      background: linear-gradient(135deg, #2f7a6b, #15554a);
      box-shadow: 0 15px 20px -8px rgba(0, 50, 40, 0.5),
                  0 0 0 1px rgba(255, 255, 255, 0.2) inset;
    }

    .nav-btn.listen:hover {
      box-shadow: 0 24px 28px -12px rgba(0, 55, 45, 0.6),
                  0 0 0 1px rgba(255, 255, 255, 0.4) inset;
    }

    .credit {
      text-align: center;
      font-size: 1.1rem;
      color: #3d506b;
      border-top: 1px solid rgba(100, 130, 170, 0.3);
      padding-top: 2rem;
      margin-top: 0.8rem;
      font-weight: 400;
      letter-spacing: 0.3px;
      backdrop-filter: blur(4px);
    }

    .credit span {
      font-weight: 600;
      color: #1b2e4b;
      background: rgba(255, 255, 255, 0.5);
      padding: 0.2rem 0.8rem;
      border-radius: 40px;
      display: inline-block;
      box-shadow: 0 1px 6px rgba(0,0,0,0.05);
    }

    /* 移动端适配 */
    @media (max-width: 600px) {
      .card {
        padding: 2.5rem 1.5rem;
        border-radius: 2.5rem;
      }

      h1 {
        font-size: 1.8rem;
        margin-bottom: 1.8rem;
      }

      .button-group {
        gap: 1.2rem;
        flex-direction: column;
        align-items: stretch;
        margin-bottom: 2.2rem;
      }

      .nav-btn {
        min-width: unset;
        width: 100%;
        font-size: 1.2rem;
        padding: 1rem 1.2rem;
        justify-content: center;
      }

      .credit {
        font-size: 1rem;
        padding-top: 1.5rem;
      }
    }

    /* 焦点样式，提升可访问性 */
    .nav-btn:focus-visible {
      outline: 3px solid #ffbf47;
      outline-offset: 4px;
    }
  </style>
</head>
<body>
  <div class="card">
    <h1>🎧 导引 · 音频与听力</h1>

    <div class="button-group">
      <!-- 第一个按钮：课文音频 (指向 audio) -->
      <a 
        href="https://sorazorashii.github.io/webtts/audio" 
        class="nav-btn"
        target="_blank" 
        rel="noopener noreferrer"
      >
        📖 课文音频
      </a>

      <!-- 第二个按钮：听力制作 (指向 listen) -->
      <a 
        href="https://sorazorashii.github.io/webtts/listen" 
        class="nav-btn listen"
        target="_blank" 
        rel="noopener noreferrer"
      >
        ✍️ 听力制作
      </a>
    </div>

    <!-- 下方设计署名 -->
    <div class="credit">
      <span>Design by Biiiiiilly</span>
    </div>
  </div>
</body>
</html>
